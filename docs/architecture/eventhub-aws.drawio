        <mxCell id="legend-line-progress-text" value="In progress: branch infra/edge, never yet run on AWS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
