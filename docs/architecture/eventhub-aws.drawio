        <mxCell id="title-text" value="EventHub on AWS: the EKS demo environment" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=30;fontStyle=1;fontColor=light-dark(#232F3E,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="2400" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" value="A multi-tenant event platform (15 Node.js processes, a Kong gateway and a TanStack Start web app) on Amazon EKS in ap-southeast-2. Terraform builds the account side; Argo CD deploys main. Run in timeboxed demo windows and torn down after each." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=light-dark(#232F3E,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="45" y="68" width="2500" height="26" as="geometry" />
        </mxCell>
