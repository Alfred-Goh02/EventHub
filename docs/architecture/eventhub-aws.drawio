          <mxGeometry x="2650" y="1460" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-proven-text" value="Proven on AWS: request and infrastructure flows" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
