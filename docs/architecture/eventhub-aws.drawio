        <mxCell id="legend-line-planned-text" value="Planned: needs a domain, not chosen yet" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
