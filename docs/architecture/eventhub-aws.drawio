        <mxCell id="legend-line-event-text" value="Proven on AWS: the event path (outbox, Kafka)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="1">
