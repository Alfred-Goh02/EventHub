{
  "type": "record",
  "name": "AuthUserContact",
  "namespace": "eventhub.auth",
  "doc": "A user's current address, sealed for Notification: its contact card. COMPACTED, keyed by `tenantId:userId`, so the topic holds the latest card for every user and a new consumer reads them all from the start. A tombstone (a null value under a key) means the user's card is withdrawn and a consumer must delete its copy. The address is inside `sealed`, encrypted to Notification's public key, so Kafka, Auth's outbox table and any log hold only ciphertext.",
  "fields": [
    {
      "name": "messageId",
      "type": "string",
      "doc": "The OutboxMessage id, added by the relay. It is also the jti inside the seal, so a sealed card copied into another message does not match it."
    },
    {
      "name": "occurredAt",
      "type": "string",
      "doc": "ISO-8601, UTC, milliseconds. When the card was queued, stamped by Auth from the database clock in the transaction that queued it, and repeated inside the seal. It is the ordering key: a consumer keeps the card with the latest occurredAt, so an older card replayed after a newer one cannot replace it, and because it is signed, a replayed card cannot claim to be newer than it is."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Required, and in the payload rather than implied: a Kafka topic is not tenant-scoped. Repeated inside the seal, which is the copy a consumer trusts."
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "The user the card is for. With tenantId it forms the Kafka key; the user id alone would let one tenant's card compact away another's under a colliding id."
    },
    {
      "name": "sealed",
      "type": "string",
      "doc": "A compact JWE (alg RSA-OAEP-256, enc A256GCM) to Notification's public key, named by kid. Its plaintext is a compact JWS signed by Auth (RS256, typ auth-contact+jwt, aud eventhub-notification, no exp) whose claims carry the tenant and the address. The typ is what stops a card being accepted as an email request, which is sealed and signed by the same keys."
    }
  ]
}
