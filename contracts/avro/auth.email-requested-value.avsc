{
  "type": "record",
  "name": "AuthEmailRequested",
  "namespace": "eventhub.auth",
  "doc": "Auth asks Notification to send an email that carries a credential. Everything that could take over an account, or say whose account it is, is inside `sealed`: encrypted to Notification's public key, so Kafka, Auth's outbox table and any log hold only ciphertext. Not compacted: every request is its own event, and Auth revokes the earlier link when it issues a newer one, a user's reset or an address's invitation.",
  "fields": [
    {
      "name": "messageId",
      "type": "string",
      "doc": "The OutboxMessage id, added by the relay. Stable across relay retries, so a consumer can recognise a redelivery. It is also the jti inside the seal, so a sealed payload copied into a different message does not match it."
    },
    {
      "name": "occurredAt",
      "type": "string",
      "doc": "ISO-8601. When the request COMMITTED, from OutboxMessage.createdAt, not when it was published."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Required, and in the payload rather than implied: a Kafka topic is not tenant-scoped. Repeated inside the seal, which is the copy a consumer trusts."
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Whom the email is about, and the sub claim inside the seal: the User for a PASSWORD_RESET, the Invite for an INVITATION, whose recipient is not a user yet. Named userId because resets came first; a consumer must not look it up as a user for every kind. Also the Kafka message key, so one subject's requests stay in order."
    },
    {
      "name": "kind",
      "type": {
        "type": "enum",
        "name": "AuthEmailKind",
        "symbols": ["PASSWORD_RESET", "INVITATION"]
      },
      "doc": "Which email. Adding a symbol is BACKWARD-compatible, and INVITATION was added that way. Repeated inside the seal, which is the copy a consumer trusts; the two must agree."
    },
    {
      "name": "expiresAt",
      "type": "string",
      "doc": "ISO-8601. When the link inside stops working, in plaintext so a consumer can drop a stale request without decrypting it. The exp claim inside the seal is the same instant, and that is the copy to trust."
    },
    {
      "name": "sealed",
      "type": "string",
      "doc": "A compact JWE (alg RSA-OAEP-256, enc A256GCM) to Notification's public key, named by kid. Its plaintext is a compact JWS signed by Auth (RS256, typ auth-email+jwt, aud eventhub-notification) whose claims carry the address and the link. Encryption keeps the credential off the topic; the signature proves Auth wrote it, since anyone can encrypt to a public key."
    }
  ]
}
