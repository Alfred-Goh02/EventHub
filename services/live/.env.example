# Copy to .env and adjust. The real .env is gitignored.
#
# Two connection strings on purpose, the same split every other service uses.
# DATABASE_URL owns the tables and runs migrations; APP_DATABASE_URL owns nothing
# and is what the service connects as at runtime. That separation is what makes
# row-level security work — a table owner silently bypasses its own policies.

NODE_ENV=development
PORT=3004
LOG_LEVEL=info

DATABASE_URL=postgresql://eventhub_live_owner:eventhub_live_owner@127.0.0.1:5432/eventhub_live
APP_DATABASE_URL=postgresql://eventhub_live_app:eventhub_live_app@127.0.0.1:5432/eventhub_live

# 127.0.0.1, not localhost.
#
# Node resolves localhost to ::1 before 127.0.0.1, and Docker Desktop's port
# mapping does not always behave identically on IPv6. The result is an
# intermittent ECONNREFUSED that reads as a Redis fault and is not one. The same
# reasoning applies to the Postgres and Kafka addresses above and below.
REDIS_URL=redis://127.0.0.1:6379

KAFKA_BROKERS=127.0.0.1:9092

# WebSocket handshakes are NOT subject to CORS. The browser sends Origin and
# enforces nothing, so the server checks it. A suffix rather than an exact match
# so subdomains work without maintaining a list.
ALLOWED_ORIGIN_SUFFIX=.eventhub.local

# Verified on the way in, not just stamped on the way out. Must match what Auth
# signs with, or every socket is refused at the handshake.
JWT_ISSUER=https://auth.eventhub.local
JWT_AUDIENCE=eventhub-api

# Auth's PUBLIC key — the half that verifies and cannot sign. Set exactly one of
# these; setting both is refused, because two sources for a verifying key can
# disagree and the symptom is a 401 nobody can explain.
#
#   AUTH_PUBLIC_KEY_B64   the key itself, base64 of the SPKI PEM. A PEM contains
#                         newlines, and newlines break .env parsing three
#                         different ways.
#   AUTH_PUBLIC_KEY_FILE  a path to the PEM. What docker compose uses, because
#                         the keypair does not exist until a setup step has
#                         generated it into a shared volume.
#
# Generate the base64 form from the repository root:
#   node -e "console.log(require('fs').readFileSync('services/auth/keys/public.pem','base64'))"
AUTH_PUBLIC_KEY_B64=
# AUTH_PUBLIC_KEY_FILE=/run/eventhub/keys/public.pem

# How long to keep serving after the readiness probe starts failing, so the load
# balancer can finish deregistering before anyone is hung up on. Must be shorter
# than terminationGracePeriodSeconds and longer than deregistration_delay.
# LIVE_DRAIN_DELAY_MS=15000
