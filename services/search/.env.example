# Copy to .env and adjust. The real .env is gitignored.
#
# NO DATABASE_URL, AND THAT ABSENCE IS THE POINT. This service owns no database.
# Postgres stays the write model; Search owns a derived read model in OpenSearch,
# fed one-way from Kafka and rebuildable by definition. Search never connects to
# Postgres, so there is no connection string to get wrong.

NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# 127.0.0.1, not localhost: Node resolves localhost to ::1 first and Docker
# Desktop's port mapping does not always behave the same on IPv6.
OPENSEARCH_NODE=http://127.0.0.1:9200

# No variables for the index or alias names, on purpose. The service addresses
# the aliases events-read and events-write, fixed in index-definition.ts; a
# mapping change ships by building events-v2 and repointing what those names
# resolve to, never by renaming them.

# `none` locally, because the security plugin is disabled and there is nothing
# to sign. `aws-sigv4` against a managed domain — declared but not wired yet, and
# the client refuses to start in that mode rather than connecting unsigned.
OPENSEARCH_AUTH_MODE=none
# AWS_REGION=ap-southeast-1

KAFKA_BROKERS=127.0.0.1:9092

# ONE group, so partitions are divided across replicas rather than every replica
# indexing every message. This is the case where Kafka's load-balancing is
# exactly what you want — the opposite of the Live service's fan-out problem.
KAFKA_CONSUMER_GROUP=search-indexer
