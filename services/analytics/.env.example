# Copy to .env and adjust. The real .env is gitignored.
#
# NO DATABASE_URL. Analytics owns no Postgres database: its store is ClickHouse,
# derived from Kafka and rebuildable by replaying the topics.

NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# The HTTP interface. 127.0.0.1 rather than localhost, as elsewhere: Node tries
# ::1 first and Docker Desktop's IPv6 port mapping is not always the same.
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=analytics

# What the running service connects as: SELECT and INSERT on analytics.*, and
# nothing else. Created by db/clickhouse-init on ClickHouse's first boot.
CLICKHOUSE_USER=analytics_app
CLICKHOUSE_PASSWORD=analytics_app

# The read API's tokens are rejected unless iss and aud match these exactly.
JWT_ISSUER=https://auth.eventhub.local
JWT_AUDIENCE=eventhub-api

# Auth's PUBLIC key, which verifies tokens and cannot mint them. Exactly one of:
#
#   AUTH_PUBLIC_KEY_B64   base64 of the SPKI PEM. A PEM contains newlines, which
#                         break .env parsing; base64 does not.
#   AUTH_PUBLIC_KEY_FILE  a path to the PEM. What docker compose uses, because the
#                         keypair only exists once a setup container has made it.
#
# Left empty here because it is GENERATED, not configured: the base64 of
# services/auth/keys/public.pem once generate-keys has run.
AUTH_PUBLIC_KEY_B64=
# AUTH_PUBLIC_KEY_FILE=/run/eventhub/keys/public.pem

# --- The ingest process (pnpm run consume), which reads Kafka and writes the
# --- raw table as the same analytics_app user.

# Its own small listener for probes and /metrics, apart from the API's PORT.
INGEST_PORT=3016
KAFKA_BROKERS=127.0.0.1:9092
# tickets.reserved and tickets.purchased are Avro; the registry resolves them.
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081
KAFKA_CONSUMER_GROUP=analytics-ingest
# earliest fills a fresh store from retained history. latest loses messages on
# any partition the group never committed on — verifiers only.
INGEST_START_FROM=earliest

# Read ONLY by the migration runner (pnpm run migrate), never by the service.
# The process answering requests must not hold a credential that can DROP TABLE.
CLICKHOUSE_MIGRATOR_USER=analytics_migrator
CLICKHOUSE_MIGRATOR_PASSWORD=analytics_migrator
