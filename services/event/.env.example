# Copy to .env and adjust. The real .env is gitignored.

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Event's OWN database. This service has no credential for eventhub_auth, and
# CONNECT is revoked from PUBLIC there, so it cannot open a session against
# Auth's data even by accident. Every cross-service need becomes an explicit
# API call or a Kafka event instead of a quiet JOIN.
DATABASE_URL=postgresql://eventhub_event_owner:eventhub_event_owner@localhost:5432/eventhub_event
APP_DATABASE_URL=postgresql://eventhub_event_app:eventhub_event_app@localhost:5432/eventhub_event

# Auth's PUBLIC key, base64-encoded SPKI PEM. Verifies tokens; cannot mint them.
# Base64 because a PEM contains newlines, and newlines break .env parsing, Helm
# values and Terraform variables in three different ways.
# Generate with:
#   node -e "console.log(require('fs').readFileSync('../auth/keys/public.pem','base64'))"
AUTH_PUBLIC_KEY_B64=

# Must match what Auth signs, or every token is rejected.
JWT_ISSUER=https://auth.eventhub.local
JWT_AUDIENCE=eventhub-api
