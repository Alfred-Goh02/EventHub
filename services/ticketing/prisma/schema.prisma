generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Same two invariants as the Event service, for the same reasons:
///
///   1. Every parent carries @@unique([tenantId, id]) and children reference the
///      PAIR, because foreign-key checks run as the table owner and BYPASS row
///      security — a plain id FK would let a caller scoped to tenant A attach a
///      child to tenant B's row, silently.
///   2. No unique index omits tenantId, because unique enforcement also bypasses
///      row security and a collision would reveal another tenant's data.

/// Ticketing's local copy of what it needs to know about an Event.
///
/// It CANNOT join to eventhub_event — CONNECT is revoked and this service has no
/// credential for that database. So it consumes events.activity and keeps this
/// projection instead. That is the honest price of database-per-service: a join
/// becomes a subscription.
model EventProjection {
  id       String @id
  tenantId String

  title       String
  slug        String
  status      String
  capacity    Int
  startsAt    DateTime
  endsAt      DateTime
  organiserId String
  deleted     Boolean @default(false)

  /// The Event.version this projection was built from.
  ///
  /// The monotonic guard: apply a message only when its version is HIGHER than
  /// what is stored. That single check makes the projection safe under BOTH
  /// at-least-once redelivery AND out-of-order arrival — neither can move it
  /// backwards. Without it, a redelivered older snapshot silently reverts state.
  sourceVersion Int

  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// Inventory for one class of ticket.
///
/// The four counters are the heart of the chapter. total is fixed; the other
/// three move between each other and must always sum to it:
///
///   remaining + held + sold = total
///
/// That is a CHECK constraint, not a convention. If a bug ever breaks it the
/// transaction fails loudly rather than overselling quietly — and overselling
/// is the failure that costs money and reputation.
model TicketType {
  id       String @id @default(cuid())
  tenantId String
  eventId  String

  name       String
  priceCents Int

  total     Int
  /// Available to sell right now.
  remaining Int
  /// Reserved but not paid for. Returns to `remaining` when a hold expires.
  held      Int @default(0)
  /// Paid for. Never returns.
  sold      Int @default(0)

  version Int @default(1)
  /// What the inventory editor's If-Match compares. Moves only when an organiser edits
  /// the name, price or total; `version` moves with every sale and expiry too.
  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event EventProjection  @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict)
  items ReservationItem[]

  @@unique([tenantId, id])
  @@index([tenantId, eventId])
}

enum ReservationStatus {
  /// Seats are held, the clock is running.
  HELD
  /// Payment is in flight. The clock is STOPPED — the sweeper must not reclaim
  /// seats from someone whose card is being charged, or they pay for nothing.
  PENDING_PAYMENT
  CONFIRMED
  /// The hold ran out and the seats went back to `remaining`.
  EXPIRED
  CANCELLED
}

model Reservation {
  id       String @id @default(cuid())
  tenantId String
  eventId  String

  /// A User id from Auth's database. No foreign key: that table is in another
  /// database this service cannot connect to. Always taken from the verified
  /// token, never from the request body.
  userId String

  status ReservationStatus @default(HELD)

  /// When the hold lapses. Enforced by a sweeper, NOT by an index predicate:
  /// now() is STABLE rather than IMMUTABLE, so `WHERE expiresAt > now()` is
  /// rejected with "functions in index predicate must be marked IMMUTABLE".
  /// Expiry is therefore a state transition someone performs, not a view.
  expiresAt DateTime

  /// Set when the payment provider call starts. While this is set the sweeper
  /// leaves the row alone.
  paymentStartedAt DateTime?
  confirmedAt      DateTime?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReservationItem[]

  @@unique([tenantId, id])
  /// A buyer's reservations, in the order GET /reservations pages them.
  @@index([tenantId, userId, createdAt, id])
  @@index([tenantId, eventId])
  /// NOTE: the sweeper's index is created as raw SQL in the migration, predicated
  /// on status rather than on time — see expiresAt above.
}

model ReservationItem {
  id       String @id @default(cuid())
  tenantId String

  reservationId String
  ticketTypeId  String
  quantity      Int

  /// The unit price AT HOLD TIME, copied from TicketType when the hold is taken.
  ///
  /// Without it the amount charged is whatever priceCents says at pay time, not
  /// what the buyer was shown. An organiser editing the price while someone is
  /// in checkout would silently change what they pay, and they would have agreed
  /// to a different number.
  ///
  /// It also makes the charge amount reconstructible from the reservation alone,
  /// which is what payment reconciliation needs — the amount must not depend on
  /// a mutable row somewhere else.
  unitPriceCents Int

  reservation Reservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  ticketType  TicketType  @relation(fields: [tenantId, ticketTypeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, reservationId, ticketTypeId])
  @@index([tenantId, ticketTypeId])
}

/// Makes a retried POST safe to replay.
///
/// The row is claimed before the work starts and completed after, in ONE
/// transaction -- so a crash rolls both back and never leaves a claimed-but-
/// unfinished key behind.
///
/// THIS COMMENT USED TO DESCRIBE A TWO-PHASE CLAIM with a 60-second lease, and
/// there was a leaseExpiresAt column and a takeover clause to match. The intent
/// was to stop a killed process wedging a key forever. But taking a key over
/// means RUNNING THE WORK AGAIN, and for this endpoint that is a second hold --
/// the exact thing the key exists to prevent. Reproduced: one key, two
/// reservations. And because the claim and the work share a transaction, the
/// wedged state it recovered from could not occur in the first place.
///
/// The lease is gone. A leftover in_progress row now makes that one key answer
/// 409 until an operator deletes it, which is the recoverable direction.
model IdempotencyKey {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  key      String
  endpoint String

  /// sha256(method + path + canonical body). Without it, someone who observes a
  /// victim's Idempotency-Key can send it with a DIFFERENT body and receive the
  /// victim's stored response.
  requestHash String

  /// 'in_progress' | 'completed'
  state String @default("in_progress")

  responseStatus Int?
  responseBody   Json?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped by tenant AND user. Keyed on `key` alone, tenant B replaying tenant
  /// A's key would receive A's cached response body verbatim.
  @@unique([tenantId, userId, endpoint, key])
  @@index([tenantId, createdAt])
}

/// Consumer-side deduplication.
///
/// Delivery is at-least-once — the relay can crash after producing and before
/// committing, and will republish on restart. Every consumer must therefore
/// recognise a message it has already applied. messageId is the outbox row id,
/// stable across relay retries; (topic, partition, offset) is not, because a
/// redelivery gets a new offset.
model ProcessedMessage {
  id            String   @id @default(cuid())
  tenantId      String
  consumerGroup String
  messageId     String
  processedAt   DateTime @default(now())

  @@unique([tenantId, consumerGroup, messageId])
  @@index([processedAt])
}

/// How far each partition has been consumed. An OPERATIONAL RECORD, not a
/// control — nothing in request handling reads it.
///
/// Written in the SAME transaction as the projection update, so it cannot claim
/// progress the projection did not make, and guarded so it cannot move
/// backwards: the consumer subscribes fromBeginning against a compacted topic,
/// so replays are routine, and an unguarded write rewound this to 0 on each one.
/// See src/checkpoint-upsert.ts.
///
/// THIS COMMENT USED TO CLAIM THE TABLE DISAMBIGUATES 404 FROM 503 — that a lag
/// near zero means the event genuinely does not exist, and a high lag means this
/// service is behind. That was the intent and it is not what happens. The
/// function built for it, projectionLagSeconds(), measured wall-clock since the
/// last checkpoint WRITE and called that lag, which on a healthy idle system
/// reads as hours; it was replaced by projectionIsCurrent(), which reads a
/// recent heartbeat and a recent EMPTY fetch from the consumer's own memory and
/// never touches this table.
///
/// The comment is corrected rather than deleted because the wrong version is
/// instructive: this repository has already lost a mechanism to exactly this —
/// documented, exported, and called by nothing. A comment describing a control
/// that does not exist is how the next reader comes to trust a number no code
/// depends on.
model ConsumerCheckpoint {
  id            String @id @default(cuid())
  consumerGroup String
  topic         String
  partition     Int

  lastOffset          BigInt
  lastMessageOccurred DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([consumerGroup, topic, partition])
}

/// Ticketing's own outbox, same shape as the Event service's.
///
/// Identical on purpose: the relay reads `topic` off the row and is otherwise
/// routing-free, so draining this table needs a different connection string and
/// nothing else.
model OutboxMessage {
  id       String @id @default(cuid())
  tenantId String

  seq BigInt @default(autoincrement())

  topic         String
  eventType     String
  schemaVersion Int    @default(1)
  aggregateId   String

  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  deadLetteredAt DateTime?

  /// NOTE: no @@index([publishedAt, seq]) — Postgres cannot use a leading
  /// IS NULL column to supply ORDER BY, so that index restricts rows and then
  /// SORTS, degrading exactly as the backlog grows. The partial index is raw
  /// SQL in the migration.
  ///
  /// A SECOND partial index is raw SQL there too: OutboxMessage_backoff_idx, on
  /// (tenantId, aggregateId, topic, seq) where the row is unpublished, not
  /// dead-lettered, and HAS a nextAttemptAt. The relay refuses to publish a row
  /// while an older row for the same aggregate is waiting out a retry backoff,
  /// and without an index for that predicate the check rescans every undelivered
  /// row per candidate — worst during the broker outage that put them there.
  /// This index holds only rows that are backing off, so it is empty whenever
  /// nothing is wrong.
  ///
  /// It exists here as well as in Event because both databases are drained by
  /// the same relay code, which takes only a different connection string.
  @@index([tenantId])
}

enum PaymentStatus {
  /// Sent to the provider, or about to be. The row exists BEFORE the call, so a
  /// crash mid-charge leaves evidence that a charge may have happened.
  PENDING
  SUCCEEDED
  FAILED
  /// The provider was asked and could not say. Needs a human or a later retry —
  /// deliberately distinct from FAILED, because assuming failure when the money
  /// moved is the expensive mistake.
  UNKNOWN
}

/// One attempt to charge for a reservation.
///
/// This table is what makes the reconciliation job writable. Without it, a
/// process that dies mid-charge leaves a reservation stuck in PENDING_PAYMENT
/// with nothing recording that a charge was ever attempted, no provider
/// reference to ask about, and no amount to compare — so the only options are
/// to release the seats (when the money may have moved) or to leave them held
/// forever. Neither is acceptable, and both are avoidable by writing this row
/// BEFORE calling the provider.
///
/// One row per ATTEMPT, not per reservation. That is what makes a retry
/// chargeable: the provider idempotency key is this row's id, so a fresh attempt
/// carries a fresh key. Deriving the key from reservationId alone would make
/// every retry collide with the original failed charge and return its result
/// forever.
model Payment {
  id       String @id @default(cuid())
  tenantId String

  reservationId String
  /// From the verified token, never the request body.
  userId String

  /// Computed from ReservationItem.unitPriceCents at hold time, so the amount
  /// cannot drift if someone edits the ticket price mid-checkout.
  amountCents Int
  currency    String @default("SGD")

  status PaymentStatus @default(PENDING)

  /// The provider's own charge identifier, once known. Null while PENDING, and
  /// null forever if the provider never answered — which is exactly the case
  /// reconciliation has to resolve.
  providerRef String?

  failureReason String?

  /// Set when the provider call starts and when it settles. The gap between
  /// them is the window in which a crash leaves an UNKNOWN.
  startedAt DateTime  @default(now())
  settledAt DateTime?

  /// How many times the reconciler has ASKED the provider about this attempt
  /// and been unable to get an answer at all -- a thrown lookup, not an
  /// `unknown` outcome, which is a real answer meaning "still in flight".
  lookupAttempts Int @default(0)

  /// When this attempt may be asked about again.
  ///
  /// The candidate query is ORDER BY startedAt with no cursor, so without
  /// this a payment whose lookup fails deterministically is selected FIRST on
  /// every pass forever, and enough of them shrink the batch to nothing.
  ///
  /// NOT NULL, defaulting to now(): a payment that has never been looked up
  /// is due NOW, which is a fact about the row rather than an absence of one.
  /// It was nullable first, and the resulting
  /// `nextLookupAt IS NULL OR nextLookupAt <= now()` forced a bitmap scan and
  /// a Sort over every unsettled payment before the LIMIT could take a page.
  /// Without the OR the index serves the ORDER BY too and the LIMIT stops the
  /// scan.
  nextLookupAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped by tenant, like every unique index in this database — unique
  /// enforcement is not subject to row security, so a global unique would let a
  /// 23505 reveal that another tenant already used a value.
  @@unique([tenantId, id])
  @@index([tenantId, reservationId])
  /// NOTE: the reconciliation index is raw SQL in the migration, because it is
  /// PARTIAL (WHERE "settledAt" IS NULL) and Prisma cannot express a predicate.
  /// Same reason as Reservation_sweep_idx and OutboxMessage_undelivered_idx: the
  /// job only ever asks for attempts that never settled, so the index should hold
  /// only those and stay small no matter how much payment history accumulates.
}
