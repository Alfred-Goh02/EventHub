# Copy to .env and adjust. The real .env is gitignored.

NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Ticketing's OWN database. This service has no credential for eventhub_auth or
# eventhub_event, and CONNECT is revoked from PUBLIC on both, so it cannot open
# a session against either. Everything it knows about an Event arrives over
# Kafka and lives in its EventProjection table.
DATABASE_URL=postgresql://eventhub_ticketing_owner:eventhub_ticketing_owner@localhost:5432/eventhub_ticketing
APP_DATABASE_URL=postgresql://eventhub_ticketing_app:eventhub_ticketing_app@localhost:5432/eventhub_ticketing

# Auth's PUBLIC key, base64-encoded SPKI PEM. Verifies tokens; cannot mint them.
AUTH_PUBLIC_KEY_B64=

JWT_ISSUER=https://auth.eventhub.local
JWT_AUDIENCE=eventhub-api

KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# The shared secret the payment provider signs its webhooks with.
#
# MANDATORY: this service refuses to start without it, deliberately. A webhook
# route with no secret is an unauthenticated write path into payment state, and
# a service that boots anyway would be one config mistake from accepting
# anybody's "charge.succeeded".
#
# This value was missing from this file for the whole of the payment work, so
# the documented way to run Ticketing did not work. Nothing caught it because
# CI sets its environment from the workflow rather than from here, which is why
# scripts/verify-env-example.mjs now boots every service from this file alone.
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret

# The hold sweeper runs as its own process with its own credential, because it
# operates ACROSS tenants — a TTL sweep selects by expiry, which has no tenant.
# It holds SELECT plus column-level UPDATE only, and refuses to start if it can
# insert a reservation.
SWEEPER_DATABASE_URL=postgresql://eventhub_ticketing_sweeper:eventhub_ticketing_sweeper@localhost:5432/eventhub_ticketing
SWEEPER_BATCH_SIZE=100
SWEEPER_INTERVAL_MS=5000
