# Copy to .env and adjust. The real .env is gitignored.
#
# Two connection strings on purpose. DATABASE_URL owns the tables and runs
# migrations; APP_DATABASE_URL owns nothing and is what the service connects as
# at runtime. That separation is what makes row-level security work — a table
# owner silently bypasses its own policies, and a superuser bypasses them even
# with FORCE. Both roles are created by db/init/01-bootstrap.sql.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://eventhub_auth_owner:eventhub_auth_owner@localhost:5432/eventhub_auth
APP_DATABASE_URL=postgresql://eventhub_auth_app:eventhub_auth_app@localhost:5432/eventhub_auth

# Verified on the way in, not just stamped on the way out.
JWT_ISSUER=https://auth.eventhub.local
JWT_AUDIENCE=eventhub-api

# Number of proxy hops in front of this service (1 for a single load balancer).
# Leave unset for direct exposure.
#
# /forgot-password and /login rate-limit per IP, and req.ip is the socket
# address unless this is set. Behind a proxy with this unset, every request
# shares one IP and the per-IP budget throttles the whole deployment --
# silently, because /forgot-password answers 202 either way. Set when NOT behind
# a proxy, any client can forge X-Forwarded-For and the limit is decorative.
#
# THIS IS ALSO WHAT KEEPS /login's LOCKOUT FIX WORKING. The budget that refuses
# a password guesser is keyed on (tenant, email, address) so that spending it
# locks out only the address that spent it. Behind a proxy with this unset,
# every caller IS one address, that key collapses back to (tenant, email), and
# a stranger can once again lock an account's owner out by guessing at it.
# TRUST_PROXY=1

# /login's failure budgets, per 15-minute window.
#
# The first is the one that refuses: failures for one account from one address.
# The second is a global per-account backstop for one password tried from many
# machines, which the first cannot see. Only FAILED attempts count, the check
# happens before the password is verified, and a successful sign-in clears both.
#
# The ratio between them is the price of denying one account service: an
# attacker needs PER_ACCOUNT / PER_ACCOUNT_IP distinct addresses. Raising the
# global number raises that price and weakens the backstop against distributed
# guessing. There is no setting that improves both.
# LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=10
# LOGIN_MAX_FAILURES_PER_ACCOUNT=50

# Every /login attempt from one address, successful or not, per 15-minute
# window. Bounds how many argon2id verifies one client can make the server run,
# and catches one address trying one password against a long list of accounts --
# which neither budget above can see, since no single account is hit twice.
# LOGIN_MAX_ATTEMPTS_PER_IP=100

# POST /invites' budgets. Every invitation is an email from this platform to an
# address an admin typed, so an admin's token -- or a stolen one -- can point the
# platform's mail at anybody, and the complaints land on the sending reputation
# password resets travel on. Both keys lead with the tenant, so one tenant cannot
# spend another's. Per tenant per hour: nobody types a hundred addresses into a
# form in an hour, and a script is held to 2,400 a day. Per (tenant, address) per
# day: a lost email, a corrected role and one more resend. Past either, 429.
# INVITES_PER_TENANT_PER_HOUR=100
# INVITES_PER_ADDRESS_PER_DAY=3

# How long an invitation stays good, in hours, and so the sealed email carrying
# it: Notification will deliver a request from auth.email-requested until it
# expires. A week by default, because an invitation waits on a human.
# INVITE_TTL_HOURS=168

# Where a password-reset or accept-invite link points: the web app a reader opens
# it in. Both are emailed, so this is the address in every reset and invitation.
# Localhost is right here and wrong everywhere else, so under NODE_ENV=production
# Auth REFUSES TO START unless this is https -- forgetting it would otherwise send
# every reader a link to their own machine, and nothing would say so.
PUBLIC_APP_URL=http://localhost:3000

# Prints invite and reset tokens where a developer can read them. OFF unless set
# to 1 or true, and it REFUSES TO BOOT under NODE_ENV=production.
#
# Both links are emailed through Notification (Mailpit locally,
# http://localhost:8025); this is a second, local-only way to read them, for
# working through the flows without a mail service running.
# AUTH_DEV_TOKEN_SINK=1
