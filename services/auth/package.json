    "@eventhub/http": "workspace:*",
    "@eventhub/logger": "workspace:*",
    "@eventhub/types": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "express": "^4.21.2",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eventhub/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0",
    "tsx": "^4.19.2"
  }
