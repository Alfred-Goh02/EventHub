// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

enum Role {
  ADMIN     // manages the tenant: invites people, changes settings
  ORGANIZER // creates and publishes events
  ATTENDEE  // buys tickets, joins the community
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         Role     @default(ATTENDEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// When this user's contact card was queued for Notification; NULL if it never
  /// was. See migration 20260926000000.
  contactPublishedAt DateTime?
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// An invitation to join a tenant.
///
/// This is what replaces the trusted X-Tenant-ID header on /register. The
/// registering user never states which tenant they are joining — the invite
/// says so, and the invite was created by someone already inside it. There is
/// nothing left for the caller to lie about.
///
/// Same shape as RefreshToken on purpose: 32 random bytes handed out, only a
/// SHA-256 hash stored, single-use, with an expiry.
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       Role      @default(ATTENDEE)
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// A password reset in flight.
///
/// Same primitive as Invite and RefreshToken: 32 random bytes handed out once,
/// only the SHA-256 hash stored, single-use, with a short expiry. Minted by
/// secret-token.ts, which all three now share.
///
/// It carries its own tenantId for the same reason RefreshToken does — the
/// lookup happens BEFORE any tenant context exists, so the tenant is a RESULT
/// of the query rather than an input to it. That is also why this table is
/// RLS-exempt: a tenant policy would filter out the very row that says which
/// tenant to use. The exemption is justified in the migration and listed in
/// ci.yml, because an exemption nobody wrote down is indistinguishable from a
/// policy somebody forgot.
///
/// The TTL is 30 minutes, not the invite's 7 days. An invite waits on a human
/// who may not be at their desk; a reset is requested by someone sitting there
/// right now, and every extra minute is extra time for a token that has escaped.
model PasswordResetToken {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  /// Superseded rather than spent.
  ///
  /// Without this column a victim's own successful reset would leave an
  /// attacker's earlier token live for the rest of its TTL — the user does the
  /// one thing they are told to do, and it buys them nothing. Issuing a new
  /// token revokes the old ones, and completing a reset revokes the siblings,
  /// so at most one is ever live per user.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sibling invalidation runs on every issue and every completion, so it must
  /// not be a sequential scan. RefreshToken carries the same index for the same
  /// reason.
  @@index([userId])
  @@index([tenantId])
}

/// Auth's outbox: messages that commit with the change that caused them, and are
/// published to Kafka by a relay afterwards.
///
/// The same shape as Event's and Ticketing's, because the relay reads `topic` off
/// the row and is otherwise routing-free: draining this table takes a different
/// connection string and nothing else.
///
/// Today it carries one kind of message, a sealed email request, and its payload
/// is ciphertext (see src/email-request.ts). A dump of this table yields neither a
/// link nor an address.
model OutboxMessage {
  id       String @id @default(cuid())
  tenantId String

  seq BigInt @default(autoincrement())

  topic         String
  eventType     String
  schemaVersion Int    @default(1)
  aggregateId   String

  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  deadLetteredAt DateTime?

  /// NOTE: the drain, prune and backoff indexes are partial, so they are raw SQL
  /// in the migration; Prisma cannot express a partial index. Ticketing's schema
  /// explains why a plain (publishedAt, seq) index degrades as the backlog grows.
  @@index([tenantId])
}
