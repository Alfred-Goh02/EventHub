# Copy to .env and adjust. The real .env is gitignored.
#
# Two connection strings on purpose, the same split every other service uses.
# DATABASE_URL owns the tables and runs migrations; APP_DATABASE_URL owns nothing
# and is what the service connects as at runtime. That separation is what makes
# row-level security work — a table owner silently bypasses its own policies.

NODE_ENV=development
PORT=3007
LOG_LEVEL=info

# 127.0.0.1, not localhost: Node resolves localhost to ::1 first, and Docker
# Desktop's IPv6 port mapping does not always behave the same.
DATABASE_URL=postgresql://eventhub_notification_owner:eventhub_notification_owner@127.0.0.1:5432/eventhub_notification
APP_DATABASE_URL=postgresql://eventhub_notification_app:eventhub_notification_app@127.0.0.1:5432/eventhub_notification

KAFKA_BROKERS=127.0.0.1:9092
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081
KAFKA_CONSUMER_GROUP=notification-dispatch
DISPATCH_START_FROM=earliest
# One delay per retry tier (notification.retry.1 to .3), in milliseconds. A send
# that fails for a reason that may pass waits in these; the defaults are spent
# inside the thirty minutes a reset link lives.
DISPATCH_RETRY_DELAYS_MS=30000,300000,900000

# How long a hard bounce keeps an address suppressed, in days. Not forever: the
# reply comes from the relay above, not necessarily from the recipient's own server,
# and a relay that is wrong about a live mailbox would otherwise lock that user out
# of password resets for good. Each new hard bounce extends the window.
SUPPRESSION_TTL_DAYS=30

# A sealed request is acted on only if Auth signed it, for this issuer.
JWT_ISSUER=https://auth.eventhub.local

# Auth's PUBLIC key, which verifies that signature. Generated rather than configured:
# the base64 of services/auth/keys/public.pem. Compose sets AUTH_PUBLIC_KEY_FILE
# instead. Set exactly one. Notification's own private key is not configured here;
# it is services/notification/keys/private.pem, from
# node services/notification/scripts/generate-keys.mjs.
AUTH_PUBLIC_KEY_B64=
# AUTH_PUBLIC_KEY_FILE=/run/eventhub/keys/public.pem

# Mailpit locally: SMTP on 1025, the inbox at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=no-reply@eventhub.local
