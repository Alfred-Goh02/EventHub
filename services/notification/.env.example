# Copy to .env and adjust. The real .env is gitignored.
#
# Two connection strings on purpose, the same split every other service uses.
# DATABASE_URL owns the tables and runs migrations; APP_DATABASE_URL owns nothing
# and is what the service connects as at runtime. That separation is what makes
# row-level security work — a table owner silently bypasses its own policies.

NODE_ENV=development
PORT=3007
LOG_LEVEL=info

# 127.0.0.1, not localhost: Node resolves localhost to ::1 first, and Docker
# Desktop's IPv6 port mapping does not always behave the same.
DATABASE_URL=postgresql://eventhub_notification_owner:eventhub_notification_owner@127.0.0.1:5432/eventhub_notification
APP_DATABASE_URL=postgresql://eventhub_notification_app:eventhub_notification_app@127.0.0.1:5432/eventhub_notification
# A third role for the sweep that ends deliveries claimed and never finished. It
# crosses tenants, which no request-scoped role may do, so it is its own credential
# with SELECT and a three-column UPDATE and nothing else. The service refuses to
# sweep if this role can create a delivery, read the suppression list, or mark
# anything SENT.
SWEEPER_DATABASE_URL=postgresql://eventhub_notification_sweeper:eventhub_notification_sweeper@127.0.0.1:5432/eventhub_notification
# How long a delivery may sit PENDING before the sweep calls it abandoned, how often
# the sweep runs, and how many rows one pass may take.
SWEEP_STUCK_AFTER_MS=3600000
SWEEP_INTERVAL_MS=60000
SWEEP_BATCH_SIZE=500

KAFKA_BROKERS=127.0.0.1:9092
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081
# Password resets. The retry tiers are read by <this>-retry and replies from
# community.feed by <this>-replies, so a backlog of replies never delays a reset.
KAFKA_CONSUMER_GROUP=notification-dispatch
DISPATCH_START_FROM=earliest
# The group that keeps the sealed contact-card copy from auth.user-contact. It
# always reads from the earliest offset: the topic is compacted so a new group can
# read every user's card.
CONTACTS_CONSUMER_GROUP=notification-contacts
# One delay per retry tier (notification.retry.1 to .3), in milliseconds. A send
# that fails for a reason that may pass waits in these; the defaults are spent
# inside the thirty minutes a reset link lives.
DISPATCH_RETRY_DELAYS_MS=30000,300000,900000

# How long a hard bounce keeps an address suppressed, in days. Not forever: the
# reply comes from the relay above, not necessarily from the recipient's own server,
# and a relay that is wrong about a live mailbox would otherwise lock that user out
# of password resets for good. Each new hard bounce extends the window.
SUPPRESSION_TTL_DAYS=30

# A sealed request is acted on only if Auth signed it, for this issuer.
JWT_ISSUER=https://auth.eventhub.local
# The audience of access tokens /preferences accepts, as every other API checks.
JWT_AUDIENCE=eventhub-api
# Signs the token in every unsubscribe link. This value is PUBLIC — it is in the
# repository — and a production process refuses to start with it. Changing it breaks
# every unsubscribe link already sent.
UNSUBSCRIBE_SECRET=dev-only-unsubscribe-secret-change-me-0123456789
# The origin every unsubscribe link and List-Unsubscribe header points at, as a
# reader's mail client reaches this service. https in production, which refuses to
# start otherwise.
NOTIFICATION_PUBLIC_URL=http://localhost:3007
# Where the web app shows a post, for the link in a reply email. https in production.
PUBLIC_APP_URL=http://localhost:3000
# Where a new replies group starts on community.feed. latest: on first deploy,
# earliest would email everyone about a week of replies long since read.
COMMUNITY_START_FROM=latest
# Past this age, in milliseconds, a reply is not emailed: it may have been hidden
# since it was written. Longer than the retry tiers take.
REPLY_MAX_AGE_MS=3600000
# Reply emails one person may get in an hour. Past it, replies are held and sent as
# one digest, every DIGEST_INTERVAL_MS, carrying counts and links only.
REPLY_HOURLY_LIMIT=5
DIGEST_INTERVAL_MS=3600000
DIGEST_BATCH_SIZE=500
# The digest's own credential: who has replies waiting, across tenants, and nothing
# else. The service refuses to start if this role can do more.
DIGEST_DATABASE_URL=postgresql://eventhub_notification_digest:eventhub_notification_digest@127.0.0.1:5432/eventhub_notification

# Auth's PUBLIC key, which verifies that signature. Generated rather than configured:
# the base64 of services/auth/keys/public.pem. Compose sets AUTH_PUBLIC_KEY_FILE
# instead. Set exactly one. Notification's own private key is not configured here;
# it is services/notification/keys/private.pem, from
# node services/notification/scripts/generate-keys.mjs.
AUTH_PUBLIC_KEY_B64=
# AUTH_PUBLIC_KEY_FILE=/run/eventhub/keys/public.pem

# Mailpit locally: SMTP on 1025, the inbox at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=no-reply@eventhub.local
