generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A TIMESTAMP DEFAULT IS dbgenerated("CURRENT_TIMESTAMP"), NEVER now().
//
// Prisma 7 fills @default(now()) in the client, from this process's clock, and sends
// it in the INSERT. With Ticketing an hour fast, an outbox row's createdAt -- the
// event's occurredAt once the relay publishes it -- came out +3600 s from Postgres's
// now(). dbgenerated leaves the column out of the INSERT, and Postgres fills it.
// The DEFAULT in the database was CURRENT_TIMESTAMP all along, so there is no
// migration; `prisma migrate diff` offers a SET DEFAULT CURRENT_TIMESTAMP per column
// for ever, because introspection reads it back as now() (measured: the same
// statements again after applying them). Leave them out. @updatedAt has no such
// option, so it is the process's clock and nothing may compare one. This service
// writes its timestamps in SQL anyway; the rule holds here so a check can hold it
// everywhere. scripts/verify-event-times-from-database.mjs refuses a now() here.

enum DeliveryStatus {
  /// Claimed: the row exists, so no other consumer will send this, and nothing
  /// has been handed to a provider yet. A row stuck here means a consumer died
  /// between the claim and the send, which a sweeper re-drives.
  PENDING
  SENT
  /// A terminal failure, with the reason in lastError.
  FAILED
  /// Not sent on purpose: the address is on the suppression list.
  SUPPRESSED
}

/// The sent-log: one row per notification per channel per recipient, claimed
/// BEFORE anything is sent.
///
/// THE UNIQUE (tenantId, idempotencyKey) IS THE WHOLE DEDUPLICATION MECHANISM.
/// Kafka delivers at least once, and an email cannot be un-sent, so the claim has
/// to be one atomic statement: insert this row, or learn from the conflict that
/// another delivery already claimed it. A read-then-insert lets two concurrent
/// consumers both pass the read and both send.
///
/// The key is derived from the source message id, the channel and the recipient.
/// The source message id is the outbox row's id, which a relay retry reuses — the
/// same identity Analytics dedupes on — never a Kafka offset, which a republish
/// changes.
///
/// THE TENANT IS IN THE CONSTRAINT, not only in the key. The same key from two
/// tenants is two rows, so no tenant's delivery can suppress another's, whatever a
/// future caller builds its key from. It is also what lets this table carry RLS:
/// a unique index is not filtered by policy, so a key-only constraint would let one
/// tenant's claim collide with a row it cannot see.
///
/// Rows outlive Kafka's retention rather than being deleted once sent, because
/// this table is also the answer to "did we send this?".
model NotificationDelivery {
  id                String         @id @default(cuid())
  tenantId          String
  recipientId       String
  channel           String
  category          String
  templateKey       String
  idempotencyKey    String
  sourceMessageId   String
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  providerMessageId String?
  lastError         String?
  createdAt         DateTime       @default(dbgenerated("CURRENT_TIMESTAMP"))
  sentAt            DateTime?
  failedAt          DateTime?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, recipientId])
  /// What a sweeper for rows stuck in PENDING reads.
  @@index([status, createdAt])
  /// What retention cleanup reads.
  @@index([createdAt])
}

/// Addresses not to send to again, per tenant, because the recipient's own mail
/// server said they do not exist. channels/smtp.ts decides which refusals count, and
/// dispatch/suppression.ts says why the address is kept only as a hash.
///
/// Under the same RLS as the sent-log. The process that sends may read, add, and
/// extend, and never remove: lifting a suppression is `suppression:remove`, run as
/// the owner.
model EmailSuppression {
  id               String   @id @default(cuid())
  tenantId         String
  /// sha256 of the trimmed, lower-cased address. Never the address.
  addressHash      String
  /// HARD_BOUNCE. A COMPLAINT reason arrives with the SES webhook.
  reason           String
  /// The enhanced status code, such as 5.1.1. Never the reply's text, which can repeat the address.
  smtpStatus       String?
  /// The delivery whose refusal recorded it last.
  sourceDeliveryId String?
  /// When it stops applying, so a relay that was wrong about a live mailbox cannot
  /// lock its owner out for good. Each new hard bounce moves it out again.
  expiresAt        DateTime
  /// How many hard bounces this address has produced.
  bounces          Int      @default(1)
  createdAt        DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@unique([tenantId, addressHash])
}

/// A user's choice for one category on one channel. No row means the category's
/// default; a transactional category can never be turned off. Never deleted by the
/// service: an opt-out is evidence. See migration 20260926100000.
model NotificationPreference {
  tenantId  String
  userId    String
  category  String
  channel   String
  enabled   Boolean
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@id([tenantId, userId, category, channel])
}

/// A user's contact card from auth.user-contact: their address, SEALED to this
/// service's key, so the table holds ciphertext rather than addresses. The latest
/// card per user wins. See migration 20260926000000.
model ContactCard {
  tenantId   String
  userId     String
  /// The JWE exactly as Auth sealed it. Opened only when an email is sent.
  sealed     String
  messageId  String
  /// When Auth queued the card. An older card never replaces a newer one.
  occurredAt DateTime
  updatedAt  DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@id([tenantId, userId])
}

/// A reply held back by the per-person hourly limit, waiting for the hourly digest.
/// COUNTS AND LINKS ONLY: the post it was on and whether it answered a comment, never
/// the reply's words or its author. See migration 20260927090000.
model DigestItem {
  tenantId        String
  userId          String
  category        String
  sourceMessageId String
  postId          String
  toComment       Boolean
  /// Set when a flush takes the item into a digest; that digest's sent-log identity.
  digestId        String?
  createdAt       DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@id([tenantId, userId, category, sourceMessageId])
  @@index([createdAt])
}
