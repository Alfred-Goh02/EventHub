{
  "name": "@eventhub/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "dlq:replay": "node --env-file-if-exists=.env dist/scripts/dlq-replay.js",
    "suppression:remove": "node --env-file-if-exists=.env dist/scripts/suppression-remove.js"
  },
  "dependencies": {
    "@eventhub/auth-middleware": "workspace:*",
    "@eventhub/config": "workspace:*",
    "@eventhub/kafka": "workspace:*",
    "@eventhub/logger": "workspace:*",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "express": "^4.21.2",
    "jose": "^6.2.4",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eventhub/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0",
    "tsx": "^4.19.2"
  }
}
