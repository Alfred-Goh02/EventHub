# Copy to .env and adjust. The real .env is gitignored.

NODE_ENV=development
LOG_LEVEL=info

# The relay's OWN credential — neither the migration owner nor the service's
# runtime role. It has SELECT on OutboxMessage, column-level UPDATE on the five
# delivery-state columns, and DELETE for pruning. It cannot read Event, and the
# service refuses to start if it can.
RELAY_DATABASE_URL=postgresql://eventhub_event_relay:eventhub_event_relay@localhost:5432/eventhub_event

KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

RELAY_METRICS_PORT=3010
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_MS=1000
RELAY_MAX_ATTEMPTS=5
