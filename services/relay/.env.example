# Copy to .env and adjust. The real .env is gitignored.

NODE_ENV=development
LOG_LEVEL=info

# The relay's OWN credential — neither the migration owner nor the service's
# runtime role. It has SELECT on OutboxMessage, column-level UPDATE on the five
# delivery-state columns, and DELETE for pruning. It cannot read Event, and the
# service refuses to start if it can.
RELAY_DATABASE_URL=postgresql://eventhub_event_relay:eventhub_event_relay@localhost:5432/eventhub_event

KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

RELAY_METRICS_PORT=3010
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_MS=1000
RELAY_MAX_ATTEMPTS=5

# Pruning DELIVERED outbox rows. Nothing pruned this table before; the relay was
# granted DELETE precisely so that something could, and for a while nothing did.
#
# Dead-lettered rows are exempt entirely -- they are the only surviving record of
# a message that could never be published.
RELAY_RETENTION_DAYS=365
# Rows per DELETE, so no statement holds locks over a huge range.
RELAY_PRUNE_BATCH_SIZE=1000
# Batches per pass. Bounds the FIRST run, which on a table nobody has ever pruned
# may have years of rows -- without a ceiling the relay stops draining until it
# finishes.
RELAY_PRUNE_MAX_BATCHES=20
# How often to prune. Deliberately not once per drain: the drain loops as fast as
# it can while there is a backlog, and pruning on that cadence would spend the
# relay on maintenance exactly when it is busiest.
RELAY_PRUNE_INTERVAL_MS=3600000

# A business table that EXISTS in this database and that the relay must NOT be
# able to read. Asserted at boot, so a relay whose credential quietly gained
# SELECT on the Event tables refuses to start.
#
# Configurable because the check is meaningless if the named table is absent --
# it would pass on "relation does not exist" having tested no privilege at all.
RELAY_FORBIDDEN_TABLE=Event
