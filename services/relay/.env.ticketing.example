# The SAME relay binary, pointed at Ticketing's outbox.
#
# Nothing about the relay is service-specific: it reads `topic` off each row and
# produces to that topic keyed by `aggregateId`. Draining a second service's
# outbox therefore needs a different connection string and nothing else — which
# is why `topic` is a stored column rather than something derived from eventType.
#
# Run: node dist/index.js --once   (with these variables loaded)

NODE_ENV=development
LOG_LEVEL=info

RELAY_DATABASE_URL=postgresql://eventhub_ticketing_relay:eventhub_ticketing_relay@localhost:5432/eventhub_ticketing

# A table that EXISTS here and that the relay must not be able to read. The boot
# check fails if the named table is absent, because "relation does not exist"
# would otherwise pass the privilege assertion without testing anything.
RELAY_FORBIDDEN_TABLE=Reservation

KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Must differ from the Event relay's, or the second instance cannot bind.
RELAY_METRICS_PORT=3011
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_MS=1000
RELAY_MAX_ATTEMPTS=5
