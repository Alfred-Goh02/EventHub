generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A TIMESTAMP DEFAULT IS dbgenerated("CURRENT_TIMESTAMP"), NEVER now().
//
// Prisma 7 fills @default(now()) in the client, from this process's clock, and sends
// it in the INSERT. With Ticketing an hour fast, an outbox row's createdAt -- the
// event's occurredAt once the relay publishes it -- came out +3600 s from Postgres's
// now(). dbgenerated leaves the column out of the INSERT, and Postgres fills it.
// The DEFAULT in the database was CURRENT_TIMESTAMP all along, so there is no
// migration; `prisma migrate diff` offers a SET DEFAULT CURRENT_TIMESTAMP per column
// for ever, because introspection reads it back as now() (measured: the same
// statements again after applying them). Leave them out. @updatedAt has no such
// option, so it is the process's clock and nothing may compare one. This service
// writes its timestamps in SQL anyway; the rule holds here so a check can hold it
// everywhere. scripts/verify-event-times-from-database.mjs refuses a now() here.

/// A space is where posts live: one per event, or standing spaces a tenant keeps.
///
/// memberCount is denormalised and moved in SQL by the statement that joins or leaves,
/// for the reason every counter here is: a feed that counts members on read does one
/// aggregate per space per request, and that is the query that falls over first.
model CommunitySpace {
  id          String     @id @default(cuid())
  tenantId    String
  /// The event this space belongs to, when it belongs to one. Events live in another
  /// service and another database, so this is an id and never a foreign key.
  eventId     String?
  slug        String
  name        String
  visibility  Visibility @default(PUBLIC)
  memberCount Int        @default(0)
  createdAt   DateTime   @default(dbgenerated("CURRENT_TIMESTAMP"))
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Who may read and write in a space, and who may moderate it.
///
/// The user id comes from the token Auth signed; there is no user table here.
model Membership {
  id       String       @id @default(cuid())
  tenantId String
  spaceId  String
  userId   String
  role     SpaceRole    @default(MEMBER)
  status   MemberStatus @default(ACTIVE)
  joinedAt DateTime     @default(dbgenerated("CURRENT_TIMESTAMP"))

  /// The tenant leads every unique key in this database: a unique index is not
  /// filtered by policy, so a key that omitted it would let one tenant's insert
  /// conflict with a row it cannot see.
  @@unique([tenantId, spaceId, userId])
  @@index([tenantId, userId])
}

model Post {
  id            String        @id @default(cuid())
  tenantId      String
  spaceId       String
  authorId      String
  body          String
  status        ContentStatus @default(VISIBLE)
  reactionCount Int           @default(0)
  commentCount  Int           @default(0)
  /// Additive and time-stable, so a post's score never changes unless someone acts on
  /// it. A decay score has to be recomputed for every row before it can be ordered,
  /// which is the opposite of what an index is for.
  rankScore     Float         @default(0)
  createdAt     DateTime      @default(dbgenerated("CURRENT_TIMESTAMP"))
  editedAt      DateTime?
  /// Which half of the feed this post belongs to, decided once, by the consumer, in the
  /// same transaction as the fan-out. False means the read path queries it directly.
  /// Judging by the space's size at READ time instead loses the posts of a space that
  /// shrank under the threshold — see migration 20260924000000.
  fannedOut     Boolean       @default(false)

  @@index([tenantId, spaceId, createdAt(sort: Desc)])
}

/// A comment's place in its thread is a materialised path, not a parent pointer walked
/// at read time: `path` is an ltree of comment ids, so one indexed query returns a
/// whole subtree in thread order.
///
/// THE ID MUST SORT BY TIME, because it becomes a path label and siblings are ordered
/// lexicographically on it. cuid() is timestamp-prefixed; cuid2 is deliberately
/// unsortable and would shuffle replies.
model Comment {
  id            String               @id @default(cuid())
  tenantId      String
  postId        String
  authorId      String
  parentId      String?
  path          Unsupported("ltree")
  depth         Int
  body          String
  status        ContentStatus        @default(VISIBLE)
  reactionCount Int                  @default(0)
  createdAt     DateTime             @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([tenantId, postId])
}

/// One row per (target, user, kind), so reacting twice is the same as reacting once.
/// The counter on the target moves in the same statement that inserts or deletes.
model Reaction {
  id         String     @id @default(cuid())
  tenantId   String
  targetType TargetType
  targetId   String
  userId     String
  kind       String
  createdAt  DateTime   @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@unique([tenantId, targetType, targetId, userId, kind])
  @@index([tenantId, targetId])
}

/// One report per person per target: reporting twice is not louder.
model Report {
  id         String       @id @default(cuid())
  tenantId   String
  targetType TargetType
  targetId   String
  reporterId String
  reason     ReportReason
  note       String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@unique([tenantId, targetType, targetId, reporterId])
  @@index([tenantId, status])
}

/// The audit trail for moderation, and APPEND-ONLY AT THE PRIVILEGE LEVEL: the service
/// role is granted SELECT and INSERT here and nothing else, so a moderator cannot
/// quietly rewrite what they did, and neither can a bug. See the migration.
model ModerationAction {
  id         String     @id @default(cuid())
  tenantId   String
  /// The space the action happened in. A ban's target is a user, which names no space
  /// by itself; see migration 20260925000000.
  spaceId    String
  actorId    String
  targetType TargetType
  /// The post, the comment, or for MEMBER the user id.
  targetId   String
  action     ModAction
  reason     String?
  reportId   String?
  createdAt  DateTime   @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([tenantId, targetId])
}

/// The materialised half of the feed: rows written for members of small spaces when a
/// post appears. Large spaces are read at query time instead, because fanning a post
/// out to a hundred thousand members on write is a hundred thousand rows nobody reads.
model FeedEntry {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String
  spaceId   String
  /// The POST's createdAt, copied at fan-out, not the time this row was written — so
  /// the feed is ordered by when things happened rather than by consumer lag. Immutable,
  /// which is what makes it safe to page on. There is no score here: the feed ranks by
  /// the post's own, read at query time. See migration 20260925120000.
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@unique([tenantId, userId, postId])
  /// The keyset the feed pages on. See migration 20260924000000 for why it is not
  /// rankScore.
  @@index([tenantId, userId, createdAt(sort: Desc), postId(sort: Desc)], map: "FeedEntry_time_keyset_idx")
}

/// The transactional outbox, in the shape @eventhub/relay drains. Named and columned
/// to match the other services exactly: scripts/verify-outbox-relays.mjs requires a
/// relay in compose for every schema that has this table, and the relay reads these
/// columns by name.
model OutboxMessage {
  id       String @id @default(cuid())
  tenantId String

  seq BigInt @default(autoincrement())

  topic         String
  eventType     String
  schemaVersion Int    @default(1)
  aggregateId   String

  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(dbgenerated("CURRENT_TIMESTAMP"))

  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  deadLetteredAt DateTime?

  /// The drain, prune and backoff indexes are partial, so they are raw SQL in the
  /// migration; Prisma cannot express a partial index.
  @@index([tenantId])
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum SpaceRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  BANNED
}

enum ContentStatus {
  VISIBLE
  /// Hidden by a moderator. The row stays, so the audit trail points at something.
  HIDDEN
  /// Removed by its author.
  DELETED
}

enum TargetType {
  POST
  COMMENT
  /// A user in one space: the target of a ban. Only ModerationAction uses it; a report
  /// is always about content.
  MEMBER
}

enum ReportReason {
  SPAM
  ABUSE
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ModAction {
  HIDE
  UNHIDE
  DELETE
  BAN
  UNBAN
}
